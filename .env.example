# ===========================================================================
# Arora — Environment Variables Template
#
# USAGE:
#   cp .env.example .env
#   Fill in the values in .env
#   NEVER commit .env to version control (it is listed in .gitignore)
#
# NOTE: youtube_explode_dart requires NO API key for Phase 1.
# These slots are reserved for Phase 2 optional / fallback providers.
# ===========================================================================

# ── Optional: Fallback music API (Phase 2) ──────────────────────────────────
# If you integrate a secondary provider (e.g., Deezer, Last.fm), set here.
FALLBACK_API_BASE_URL=
FALLBACK_API_KEY=

# ── Optional: Dedicated lyrics provider (Phase 2) ───────────────────────────
# e.g., LRCLIB, Musixmatch, Genius API key
LYRICS_API_KEY=

# ── Optional: Error tracking (production only) ──────────────────────────────
# e.g., Sentry DSN for crash reporting
SENTRY_DSN=
